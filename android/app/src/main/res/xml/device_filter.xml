<?xml version="1.0" encoding="utf-8"?>
<!--
  USB-serial bridges and native-USB MCUs the flasher recognises.
  Android requires decimal vendor-id / product-id values.
-->
<resources>
    <!-- WCH CH340 / CH341 / CH9102  (0x1A86) -->
    <usb-device vendor-id="6790" product-id="21972" />  <!-- 0x1A86:0x55D4 CH9102 -->
    <usb-device vendor-id="6790" product-id="29987" />  <!-- 0x1A86:0x7523 CH340  -->
    <usb-device vendor-id="6790" product-id="21971" />  <!-- 0x1A86:0x55D3 CH343  -->

    <!-- Silicon Labs CP210x  (0x10C4) -->
    <usb-device vendor-id="4292" product-id="60000" />  <!-- 0x10C4:0xEA60 -->
    <usb-device vendor-id="4292" product-id="60016" />  <!-- 0x10C4:0xEA70 -->

    <!-- FTDI  (0x0403) -->
    <usb-device vendor-id="1027" product-id="24577" />  <!-- 0x0403:0x6001 FT232R  -->
    <usb-device vendor-id="1027" product-id="24592" />  <!-- 0x0403:0x6010 FT2232  -->
    <usb-device vendor-id="1027" product-id="24596" />  <!-- 0x0403:0x6014 FT232H  -->
    <usb-device vendor-id="1027" product-id="24597" />  <!-- 0x0403:0x6015 FT-X    -->

    <!-- Prolific PL2303  (0x067B) -->
    <usb-device vendor-id="1659" product-id="8963" />   <!-- 0x067B:0x2303 -->

    <!-- Espressif native USB  (0x303A) -->
    <usb-device vendor-id="12346" product-id="2" />     <!-- 0x303A:0x0002 USB-OTG download mode -->
    <usb-device vendor-id="12346" product-id="4097" />  <!-- 0x303A:0x1001 USB-Serial-JTAG       -->
</resources>
